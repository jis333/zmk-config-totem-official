#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define Base        0
#define Nav         1
#define Sym         2
#define Fun         3
#define Game        4
#define Gameplus    5

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };

        col_mm: col_mm {
            compatible = "zmk,behavior-mod-morph";
            label = ",’";
            bindings = <&kp COMMA>, <&kp SINGLE_QUOTE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_dot: mm_dot {
            compatible = "zmk,behavior-mod-morph";
            label = ".”";
            bindings = <&kp DOT>, <&kp DOUBLE_QUOTES>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    combos { compatible = "zmk,combos"; };

    macros {
        lcopy: line_copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp HOME &kp LS(END) &kp LC(C)>;
            label = "LINE_COPY";
        };

        outin: OutNIn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LEFT_ALT) &kp LG(L) &kp LC(LA(DELETE))>;
            label = "OUTNIN";
        };

        pw: pw {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp M &kp L &kp F &kp F &kp L &kp F &kp K &kp N0 &kp MINUS &kp RET>;
            label = "PW";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
         &kp Q       &kp W       &kp E             &kp R        &kp T          &kp Y        &kp U        &kp I            &kp O       &kp P
         &hm LGUI A  &hm LALT S  &hm LEFT_SHIFT D  &hm LCTRL F  &hm LCTRL G    &kp H        &hm LCTRL J  &hm LSHFT K      &hm LALT L  &hm LEFT_GUI SEMICOLON
&kp DEL  &kp Z       &kp X       &kp C             &kp V        &kp B          &kp N        &kp M        &col_mm          &mm_dot     &kp SLASH               &kp BACKSPACE
                                 &lt 3 ESC         &lt 2 TAB    &lt 1 ENTER    &lt 1 SPACE  &sk LSHIFT   &lt 3 RIGHT_ALT
            >;
        };

        Nav {
            display-name = "Nav";
            bindings = <
        &kp F1   &kp F2   &kp F3  &kp F4       &kp PRINTSCREEN      &kp LG(LA(SPACE))  &trans         &trans       &kp F9     &kp F10
        &kp F5   &kp F6   &kp F7  &kp F8       &kp LG(LC(LS(T)))    &kp LEFT           &kp DOWN       &kp UP       &kp RIGHT  &trans
&trans  &kp F11  &kp F12  &lcopy  &kp LC(F13)  &kp LG(LC(LS(S)))    &kp HOME           &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &trans   &trans
                          &trans  &trans       &trans               &trans             &trans         &trans
            >;
        };

        Sym {
            display-name = "Sym";
            bindings = <
        &kp EXCL          &kp AT             &kp HASH              &kp DOLLAR             &kp PERCENT    &kp CARET  &kp AMPERSAND  &kp STAR        &kp BACKSLASH  &kp PIPE
        &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans         &trans     &kp MINUS      &kp UNDERSCORE  &kp PLUS       &kp EQUAL
&trans  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LESS_THAN         &kp GREATER_THAN       &trans         &trans     &kp TILDE      &kp GRAVE       &trans         &trans     &trans
                                             &trans                &trans                 &trans         &trans     &trans         &trans
            >;
        };

        Fun {
            display-name = "Fun";
            bindings = <
        &kp F13  &kp F14  &kp F15  &kp F16  &trans    &kp MINUS   &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PLUS
        &kp F17  &kp F18  &kp F19  &kp F20  &trans    &kp SLASH   &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp ASTERISK
&trans  &kp F21  &kp F22  &kp F23  &kp F24  &trans    &kp PERIOD  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL     &trans
                          &trans   &trans   &trans    &trans      &kp NUMBER_0  &trans
            >;
        };

        layer_4 {
            bindings = <
        &outin  &pw     &mkp MB4          &mkp MB5           &trans    &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &kp LG(LC(LEFT))  &kp LG(LC(RIGHT))  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans            &trans             &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans            &trans             &trans    &trans  &trans  &trans
            >;
        };
    };
};
