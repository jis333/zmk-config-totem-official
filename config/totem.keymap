#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define Base        0
#define Nav         1
#define Sym         2
#define Fun         3
#define Game        4
#define Gameplus    5

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };

        col_sq: col_sq {
            compatible = "zmk,behavior-mod-morph";
            label = "COL_SQ";
            bindings = <&kp COMMA>, <&kp SINGLE_QUOTE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dot_dq: dot_dq {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_DQ";
            bindings = <&kp DOT>, <&kp DOUBLE_QUOTES>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        HanEng {
            bindings = <&kp LANG_HANGEUL>;
            key-positions = <28 29>;
            layers = <0>;
        };

        PgUp {
            bindings = <&kp PAGE_UP>;
            key-positions = <7 8>;
            layers = <0>;
        };

        PgDn {
            bindings = <&kp PAGE_DOWN>;
            key-positions = <17 18>;
            layers = <0>;
        };

        MoveLeft {
            bindings = <&kp LG(LC(LS(LEFT)))>;
            key-positions = <22 23>;
            layers = <0>;
        };

        Home {
            bindings = <&kp HOME>;
            key-positions = <6 7>;
            layers = <0>;
        };

        End {
            bindings = <&kp END>;
            key-positions = <16 17>;
            layers = <0>;
        };

        LeftDesktop {
            bindings = <&kp LG(LC(LEFT))>;
            key-positions = <11 12>;
            layers = <0>;
        };

        RightDesktop {
            bindings = <&kp LG(LC(RIGHT))>;
            key-positions = <12 13>;
            layers = <0>;
        };

        Back {
            bindings = <&kp LA(LEFT)>;
            key-positions = <1 2>;
            layers = <0>;
        };

        Forward {
            bindings = <&kp LA(RIGHT)>;
            key-positions = <2 3>;
            layers = <0>;
        };

        MoveRight {
            bindings = <&kp LG(LC(LS(RIGHT)))>;
            key-positions = <23 24>;
            layers = <0>;
        };
    };

    macros {
        lcopy: line_copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp HOME &kp LS(END) &kp LC(C)>;
            label = "LINE_COPY";
        };

        outin: OutNIn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LEFT_ALT) &kp LG(L) &kp LC(LA(DELETE))>;
            label = "OUTNIN";
        };

        pw: pw {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp M &kp L &kp F &kp F &kp L &kp F &kp K &kp N0 &kp MINUS &kp RET>;
            label = "PW";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
           &kp Q       &kp W       &kp E         &kp R        &kp T          &kp Y        &kp U        &kp I        &kp O       &kp P
           &hm LGUI A  &hm LALT S  &hm LSHIFT D  &hm LCTRL F  &hm LCTRL G    &kp H        &hm LCTRL J  &hm LSHFT K  &hm LALT L  &hm LGUI SEMICOLON
&lt 3 DEL  &kp Z       &kp X       &kp C         &kp V        &kp B          &kp N        &kp M        &col_sq      &dot_dq     &kp SLASH           &lt 3 BACKSPACE
                                   &lt 2 ESC     &lt 3 TAB    &lt 1 ENTER    &lt 1 SPACE  &sk LSHIFT   &lt 2 RALT
            >;

            label = "Base";
        };

        Expansion {
            bindings = <
        &kp F1   &kp F2   &kp F3  &kp F4       &kp PRINTSCREEN      &kp LG(LA(SPACE))  &kp TILDE     &kp GRAVE   &kp BSLH       &kp PIPE
        &kp F5   &kp F6   &kp F7  &kp F8       &kp LG(LC(LS(T)))    &kp LEFT           &kp DOWN      &kp UP      &kp RIGHT      &kp LANG_HANJA
&trans  &kp F11  &kp F12  &lcopy  &kp LC(F13)  &kp LG(LC(LS(S)))    &kp LC(LEFT)       &kp LC(DOWN)  &kp LC(UP)  &kp LC(RIGHT)  &kp INS         &trans
                          &trans  &trans       &trans               &trans             &trans        &trans
            >;

            label = "Fn";
        };

        Symbols {
            bindings = <
        &kp EXCL          &kp AT             &kp HASH              &kp DOLLAR             &kp PERCENT    &kp PLUS      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp STAR
        &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp CARET      &kp MINUS     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp EQUAL
&trans  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LESS_THAN         &kp GREATER_THAN       &kp AMPS       &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp UNDER  &trans
                                             &trans                &trans                 &trans         &trans        &trans        &trans
            >;

            label = "Sym";
        };

        Macro {
            bindings = <
        &kp F13  &kp F14  &kp F15   &kp F16    &trans       &trans     &trans   &trans   &pw     &outin
        &kp F17  &kp F18  &kp F19   &kp F20    &trans       &trans     &trans   &trans   &trans  &trans
&trans  &kp F21  &kp F22  &kp F23   &kp F24    &trans       &trans     &trans   &trans   &trans  &trans  &trans
                          &kp RALT  &sk LSHFT  &kp SPACE    &kp ENTER  &kp TAB  &kp ESC
            >;

            label = "Macro";
        };
    };
};
